<screen>
  <view flex_flow="column" width="100%" height="100%"
        style_bg_color="0x101722" style_bg_opa="255"
        style_pad_all="22" style_pad_row="14">

    <lv_obj name="topbar" width="100%" height="58" flex_flow="row"
            style_bg_color="0x182433" style_bg_opa="255"
            style_radius="16" style_pad_hor="18" style_pad_ver="10">
      <lv_obj flex_grow="1" flex_flow="column" style_pad_row="2">
        <lv_label text="THUIS" style_text_color="0xffffff" />
        <lv_label text="Alles binnen handbereik" style_text_color="0x91a4b8" />
      </lv_obj>
      <lv_label text="DINSDAG  •  27 OKTOBER" style_text_color="0x91a4b8" />
    </lv_obj>

    <lv_obj name="main_content" width="100%" flex_grow="1" flex_flow="row"
            style_pad_column="14">
      <lv_obj name="left_column" width="34%" height="100%" flex_flow="column"
              style_pad_row="14">
        <lv_obj name="weather_card" width="100%" height="48%" flex_flow="column"
                style_bg_color="0x20384b" style_bg_opa="255"
                style_radius="18" style_pad_all="18" style_pad_row="8">
          <lv_label text="WEER" style_text_color="0x9fc4df" />
          <lv_label text="18°" style_text_color="0xffffff" />
          <lv_label text="Licht bewolkt" style_text_color="0xd5e5f1" />
          <lv_label text="Deventer" style_text_color="0x9fc4df" />
        </lv_obj>
        <lv_obj name="climate_card" width="100%" flex_grow="1" flex_flow="column"
                style_bg_color="0x263449" style_bg_opa="255"
                style_radius="18" style_pad_all="18" style_pad_row="8">
          <lv_label text="KLIMAAT" style_text_color="0x9fc4df" />
          <lv_label text="Woonkamer" style_text_color="0xffffff" />
          <lv_label text="21.0 °C" style_text_color="0xffffff" />
          <lv_label text="Verwarming automatisch" style_text_color="0x9fc4df" />
        </lv_obj>
      </lv_obj>

      <lv_obj name="right_column" flex_grow="1" height="100%" flex_flow="column"
              style_pad_row="14">
        <lv_obj name="music_card" width="100%" height="42%" flex_flow="column"
                style_bg_color="0x263044" style_bg_opa="255"
                style_radius="18" style_pad_all="18" style_pad_row="8">
          <lv_label text="MUZIEK" style_text_color="0xb9a7ef" />
          <lv_label text="Nu aan het luisteren" style_text_color="0xffffff" />
          <lv_label text="Kies je favoriete muziek" style_text_color="0xabb8ca" />
        </lv_obj>
        <lv_obj name="agenda_card" width="100%" flex_grow="1" flex_flow="column"
                style_bg_color="0x263b36" style_bg_opa="255"
                style_radius="18" style_pad_all="18" style_pad_row="8">
          <lv_label text="AGENDA" style_text_color="0x9bd7bd" />
          <lv_label text="Vandaag" style_text_color="0xffffff" />
          <lv_label text="Geen afspraken ingepland" style_text_color="0xb4d3c5" />
        </lv_obj>
      </lv_obj>
    </lv_obj>

    <lv_obj name="navigation" width="100%" height="58" flex_flow="row"
            style_bg_color="0x182433" style_bg_opa="255"
            style_radius="16" style_pad_all="10"
            style_flex_main_place="space_between"
            style_flex_cross_place="center">
      <lv_label text="⌂  OVERZICHT" style_text_color="0xffffff" />
      <lv_label text="☼  LICHTEN" style_text_color="0x91a4b8" />
      <lv_label text="▤  ROLLUIKEN" style_text_color="0x91a4b8" />
      <lv_label text="▣  CAMERA'S" style_text_color="0x91a4b8" />
      <lv_label text="⚙  INSTELLINGEN" style_text_color="0x91a4b8" />
    </lv_obj>
  </view>
</screen>
